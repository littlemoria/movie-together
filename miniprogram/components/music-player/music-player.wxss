.music-root {
    position: fixed;
    right: 24rpx;
    z-index: 100;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
}

/* 悬浮球 */
.music-fab {
    width: 96rpx;
    height: 96rpx;
    border-radius: 48rpx;
    background: rgba(255, 255, 255, 0.94);
    border: 2rpx solid #e5e8eb;
    box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.12);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
}

.music-fab:active {
    background: #f2f3f5;
}

.music-fab-icon {
    font-size: 44rpx;
    line-height: 1;
}

/* 播放中指示点 */
.music-fab-badge {
    position: absolute;
    top: 14rpx;
    right: 16rpx;
    width: 14rpx;
    height: 14rpx;
    border-radius: 7rpx;
    background: #d93026;
}

/* 展开面板 */
.music-panel {
    width: 520rpx;
    max-height: 720rpx;
    margin-bottom: 20rpx;
    background: #ffffff;
    border: 2rpx solid #e5e8eb;
    border-radius: 20rpx;
    box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.16);
    display: flex;
    flex-direction: column;
    overflow: hidden;
}

.music-panel-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20rpx 24rpx;
    border-bottom: 2rpx solid #f2f3f5;
    flex-shrink: 0;
}

.music-panel-title {
    font-size: 28rpx;
    font-weight: 500;
    color: #1f2329;
}

.music-panel-close {
    font-size: 28rpx;
    color: #8a9199;
    padding: 0 8rpx;
}

/* 歌单 */
.music-track-list {
    flex: 1;
    overflow-y: auto;
    padding: 8rpx 0;
}

.music-track {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20rpx 24rpx;
}

.music-track:active {
    background: #f2f3f5;
}

.music-track.active {
    background: rgba(23, 105, 224, 0.08);
}

.music-track-name {
    font-size: 26rpx;
    color: #1f2329;
    flex: 1;
    margin-right: 16rpx;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.music-track-status {
    font-size: 26rpx;
    color: #8a9199;
    flex-shrink: 0;
}

.music-track.active .music-track-status {
    color: #1769e0;
}

/* 音量行 */
.music-volume-row {
    display: flex;
    align-items: center;
    padding: 16rpx 20rpx;
    border-top: 2rpx solid #f2f3f5;
    flex-shrink: 0;
}

.music-toggle {
    width: 84rpx;
    font-size: 30rpx;
    padding: 0;
    margin: 0 16rpx 0 0;
    line-height: 64rpx;
    background: #f2f3f5;
    border-radius: 12rpx;
}

.music-toggle::after {
    border: none;
}

.music-volume-slider {
    flex: 1;
    margin: 0;
}
