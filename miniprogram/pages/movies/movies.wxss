.page {
    box-sizing: border-box;
    min-height: 100vh;
    padding: 24rpx 32rpx;
}

/* 模式切换 */
.tabs {
    display: flex;
    padding: 8rpx;
    margin-bottom: 24rpx;
    background: #ececf1;
    border-radius: 16rpx;
}

.tab {
    flex: 1;
    padding: 16rpx 0;
    border-radius: 12rpx;
    font-size: 28rpx;
    color: #646a73;
    text-align: center;
}

.tab.active {
    background: #ffffff;
    color: #1769e0;
    font-weight: 600;
}

/* 工具栏 */
.toolbar {
    display: flex;
    align-items: center;
    margin-bottom: 20rpx;
}

.search-input {
    flex: 1;
    box-sizing: border-box;
    height: 80rpx;
    padding: 0 24rpx;
    border: 2rpx solid #e5e8eb;
    border-radius: 16rpx;
    font-size: 28rpx;
}

.add-btn {
    width: 120rpx;
    height: 80rpx;
    line-height: 80rpx;
    margin-left: 16rpx;
    padding: 0;
    font-size: 40rpx;
}

/* 导航行 */
.nav-row {
    display: flex;
    align-items: center;
    margin-bottom: 20rpx;
}

.nav-link {
    margin-right: 32rpx;
    font-size: 26rpx;
    color: #1769e0;
}

.nav-link-danger {
    margin-right: 0;
    margin-left: auto;
    color: #d93026;
}

/* 筛选 */
.filters {
    display: flex;
    align-items: center;
    margin-bottom: 20rpx;
}

.filter-chip {
    padding: 12rpx 28rpx;
    border: 2rpx solid #e5e8eb;
    border-radius: 999rpx;
    background: #ffffff;
    font-size: 26rpx;
    color: #1f2329;
}

.filter-clear {
    margin-left: 20rpx;
    font-size: 26rpx;
    color: #1769e0;
}

/* 状态 */
.state {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 100rpx 0;
}

.state-text {
    font-size: 28rpx;
    color: #646a73;
    text-align: center;
}

.state-sub {
    margin-top: 12rpx;
    font-size: 24rpx;
    color: #9aa0a8;
    text-align: center;
}

/* 月份分组 */
.month-group {
    margin-bottom: 32rpx;
}

.month-header {
    display: block;
    margin-bottom: 16rpx;
    font-size: 28rpx;
    font-weight: 600;
    color: #1f2329;
}

.movie-list {
    display: flex;
    flex-direction: column;
}

.movie-item {
    display: flex;
    align-items: center;
    padding: 20rpx;
    margin-bottom: 16rpx;
}

.movie-poster {
    width: 108rpx;
    height: 152rpx;
    border-radius: 12rpx;
    background: #e5e8eb;
}

.movie-poster-empty {
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 40rpx;
    background: linear-gradient(135deg, #6C5CE7, #a29bfe);
}

.movie-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    margin-left: 24rpx;
    min-width: 0;
}

.movie-name {
    font-size: 32rpx;
    font-weight: 600;
}

.movie-meta {
    margin-top: 8rpx;
    font-size: 24rpx;
    color: #646a73;
}

.movie-genre {
    margin-top: 8rpx;
    font-size: 22rpx;
    color: #1769e0;
}

.movie-by {
    margin-top: 8rpx;
    font-size: 22rpx;
    color: #1769e0;
}

/* 想看操作 */
.wishlist-actions {
    display: flex;
    flex-direction: column;
    margin-left: 16rpx;
}

.wishlist-btn {
    padding: 8rpx 24rpx;
    margin-bottom: 12rpx;
    background: #eaf2ff;
    color: #1769e0;
    font-size: 24rpx;
    line-height: 1.6;
}

.wishlist-btn::after {
    border: none;
}

.wishlist-btn-danger {
    background: #fff;
    color: #d93026;
}

/* 弹层 */
.modal-mask {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.5);
    z-index: 100;
}

.modal {
    box-sizing: border-box;
    width: 86%;
    max-height: 80vh;
    padding: 40rpx;
    overflow-y: auto;
}

.modal-title {
    display: block;
    margin-bottom: 28rpx;
    font-size: 34rpx;
    font-weight: 600;
    text-align: center;
}

.input {
    box-sizing: border-box;
    height: 88rpx;
    padding: 0 24rpx;
    margin-bottom: 16rpx;
    border: 2rpx solid #e5e8eb;
    border-radius: 16rpx;
    font-size: 28rpx;
}

.modal-actions {
    display: flex;
    margin-top: 16rpx;
}

.modal-actions button {
    flex: 1;
}

.modal-actions button:first-child {
    margin-right: 20rpx;
}

.error {
    display: block;
    margin-top: 20rpx;
    color: #d93026;
    font-size: 26rpx;
    text-align: center;
}

/* TMDB 搜索 */
.tmdb-search {
    display: flex;
    align-items: center;
    margin-bottom: 16rpx;
}

.tmdb-search .input {
    flex: 1;
    margin-bottom: 0;
}

.tmdb-btn {
    width: 140rpx;
    height: 88rpx;
    line-height: 88rpx;
    margin-left: 16rpx;
    padding: 0;
    font-size: 26rpx;
}

.tmdb-results {
    max-height: 360rpx;
    margin-bottom: 16rpx;
}

.tmdb-result {
    display: flex;
    align-items: center;
    padding: 16rpx;
    margin-bottom: 12rpx;
    border: 2rpx solid #e5e8eb;
    border-radius: 16rpx;
}

.tmdb-poster {
    width: 72rpx;
    height: 100rpx;
    border-radius: 8rpx;
    background: #e5e8eb;
}

.tmdb-poster-empty {
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 32rpx;
    background: linear-gradient(135deg, #6C5CE7, #a29bfe);
}

.tmdb-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    margin-left: 16rpx;
    min-width: 0;
}

.tmdb-title {
    font-size: 28rpx;
    font-weight: 600;
}

.tmdb-meta {
    margin-top: 6rpx;
    font-size: 22rpx;
    color: #646a73;
}

.tmdb-actions {
    display: flex;
    flex-direction: column;
    margin-left: 12rpx;
}

.tmdb-btn-sm {
    padding: 6rpx 20rpx;
    margin-bottom: 8rpx;
    background: #1769e0;
    color: #ffffff;
    font-size: 22rpx;
    line-height: 1.6;
}

.tmdb-btn-sm::after {
    border: none;
}

.tmdb-btn-wish {
    background: #eaf2ff;
    color: #1769e0;
}

/* 详情 */
.detail-modal {
    text-align: center;
}

.detail-poster {
    width: 320rpx;
    height: 450rpx;
    margin-bottom: 24rpx;
    border-radius: 16rpx;
    background: #e5e8eb;
}

.detail-title {
    display: block;
    margin-bottom: 20rpx;
    font-size: 36rpx;
    font-weight: 700;
}

.detail-meta {
    display: block;
    margin-bottom: 10rpx;
    font-size: 26rpx;
    color: #646a73;
    text-align: left;
}

/* ---------- 表单分组（对齐网页版 form-group） ---------- */
.form-group {
    margin-bottom: 28rpx;
}

.form-label {
    display: block;
    margin-bottom: 12rpx;
    font-size: 26rpx;
    color: #646a73;
}

.form-required {
    color: #d93026;
}

.form-hint {
    font-size: 24rpx;
    color: #8f959e;
}

/* 分组内的输入框：去掉自身下边距，由 form-group 统一控制间距 */
.input-group {
    margin-bottom: 0;
}

/* 日期选择器 */
.picker-wrapper {
    display: block;
}

.picker-value {
    display: flex;
    align-items: center;
    line-height: 88rpx;
    color: #1f2329;
}

.picker-placeholder {
    color: #8f959e;
}

/* 类型多选 */
.genre-grid {
    display: flex;
    flex-wrap: wrap;
}

.genre-chip {
    padding: 12rpx 24rpx;
    margin: 0 16rpx 16rpx 0;
    border: 2rpx solid #e5e8eb;
    border-radius: 12rpx;
    background: #f7f8fa;
    font-size: 26rpx;
    color: #1f2329;
}

.genre-chip-active {
    border-color: #1769e0;
    background: #eaf2ff;
    color: #1769e0;
}

/* 自定义类型添加 */
.add-genre-row {
    display: flex;
    align-items: center;
    margin-top: 12rpx;
}

.add-genre-input {
    flex: 1;
    box-sizing: border-box;
}

.add-genre-btn {
    width: 88rpx;
    height: 88rpx;
    line-height: 88rpx;
    margin-left: 16rpx;
    padding: 0;
}

/* TMDB 自动带出信息：只读展示 */
.readonly-box {
    padding: 20rpx 24rpx;
    border-radius: 16rpx;
    background: #f7f8fa;
}

.readonly-row {
    display: flex;
    align-items: flex-start;
    margin-bottom: 12rpx;
}

.readonly-row:last-child {
    margin-bottom: 0;
}

.readonly-key {
    flex-shrink: 0;
    width: 80rpx;
    font-size: 26rpx;
    color: #8f959e;
}

.readonly-val {
    flex: 1;
    font-size: 26rpx;
    color: #1f2329;
    word-break: break-all;
}
