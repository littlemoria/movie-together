.page {
    box-sizing: border-box;
    min-height: 100vh;
    padding: 32rpx;
}

.section {
    padding: 32rpx;
    margin-bottom: 24rpx;
}

.section-title {
    display: block;
    margin-bottom: 24rpx;
    font-size: 32rpx;
    font-weight: 600;
}

/* 主题 */
.theme-switch {
    display: flex;
}

.theme-option {
    flex: 1;
    padding: 20rpx 0;
    border: 2rpx solid #e5e8eb;
    border-radius: 12rpx;
    font-size: 28rpx;
    color: #646a73;
    text-align: center;
}

.theme-option:first-child {
    margin-right: 20rpx;
}

.theme-option.active {
    border-color: #1769e0;
    background: #eaf2ff;
    color: #1769e0;
    font-weight: 600;
}

/* 表单 */
.field {
    margin-bottom: 24rpx;
}

.field-label {
    display: block;
    margin-bottom: 12rpx;
    font-size: 26rpx;
    color: #646a73;
}

.input {
    box-sizing: border-box;
    height: 88rpx;
    padding: 0 24rpx;
    border: 2rpx solid #e5e8eb;
    border-radius: 16rpx;
    font-size: 28rpx;
}

.slider {
    margin: 0 8rpx;
}

.save-btn {
    margin-top: 8rpx;
}

/* 操作按钮组 */
.action-grid {
    display: flex;
    flex-wrap: wrap;
}

.action-grid button {
    flex: 1;
    min-width: 200rpx;
    margin: 0 16rpx 16rpx 0;
}

.action-grid button:nth-child(2n) {
    margin-right: 0;
}

.hint {
    display: block;
    margin-top: 8rpx;
    font-size: 22rpx;
    color: #9aa0a8;
    line-height: 1.6;
}
