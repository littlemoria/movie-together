.page {
    box-sizing: border-box;
    min-height: 100vh;
    padding: 32rpx;
}

.state {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 120rpx 0;
}

.state-text {
    font-size: 28rpx;
    color: #646a73;
}

.stats-grid {
    display: flex;
    margin-bottom: 24rpx;
}

.stat {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 32rpx 0;
}

.stat:first-child {
    margin-right: 16rpx;
}

.stat:nth-child(2) {
    margin-right: 16rpx;
}

.stat-value {
    font-size: 44rpx;
    font-weight: 700;
    color: #1769e0;
}

.stat-label {
    margin-top: 8rpx;
    font-size: 24rpx;
    color: #646a73;
}

.section {
    padding: 32rpx;
    margin-bottom: 24rpx;
}

.section-title {
    display: block;
    margin-bottom: 24rpx;
    font-size: 32rpx;
    font-weight: 600;
}

.genre-list,
.month-list {
    display: flex;
    flex-direction: column;
}

.genre-item,
.month-item {
    display: flex;
    align-items: center;
    margin-bottom: 20rpx;
}

.genre-name,
.month-label {
    width: 140rpx;
    font-size: 26rpx;
    color: #1f2329;
}

.genre-bar-wrap,
.month-bar-wrap {
    flex: 1;
    height: 24rpx;
    background: #f2f3f5;
    border-radius: 12rpx;
    overflow: hidden;
}

.genre-bar,
.month-bar {
    height: 100%;
    background: #1769e0;
    border-radius: 12rpx;
}

.genre-count,
.month-count {
    width: 80rpx;
    text-align: right;
    font-size: 24rpx;
    color: #646a73;
}

/* 日历热力图 */
.calendar {
    display: flex;
    flex-wrap: wrap;
}

.calendar-cell {
    box-sizing: border-box;
    width: 13.5%;
    padding: 12rpx 0;
    margin: 0 1% 8rpx 1%;
    border-radius: 8rpx;
    background: #f2f3f5;
    color: #646a73;
    font-size: 20rpx;
    text-align: center;
}

.calendar-cell.level-1 {
    background: #cfe4ff;
    color: #1f2329;
}

.calendar-cell.level-2 {
    background: #9ec9ff;
    color: #1f2329;
}

.calendar-cell.level-3 {
    background: #5c9dff;
    color: #ffffff;
}

.calendar-cell.level-4 {
    background: #1769e0;
    color: #ffffff;
}

.calendar-legend {
    display: flex;
    align-items: center;
    margin-top: 12rpx;
}

.legend-cell {
    width: 36rpx;
    margin: 0 6rpx 0 0;
    padding: 0;
    height: 24rpx;
}

.legend-text {
    font-size: 20rpx;
    color: #9aa0a8;
    margin-right: 8rpx;
}

/* 月度明细 */
.detail-month {
    margin-bottom: 24rpx;
}

.detail-month-label {
    display: block;
    margin-bottom: 12rpx;
    font-size: 26rpx;
    font-weight: 600;
    color: #1f2329;
}

.detail-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14rpx 0;
    border-top: 2rpx solid #f0f1f2;
}

.detail-item-name {
    flex: 1;
    font-size: 26rpx;
    color: #1f2329;
}

.detail-item-duration {
    font-size: 24rpx;
    color: #646a73;
}

.empty {
    padding: 120rpx 0;
    text-align: center;
    color: #646a73;
    font-size: 28rpx;
}
