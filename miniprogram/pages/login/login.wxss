.page {
    box-sizing: border-box;
    min-height: 100vh;
    padding: 120rpx 48rpx;
}

.hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: 64rpx;
}

.title {
    font-size: 60rpx;
    font-weight: 700;
}

.subtitle {
    margin-top: 16rpx;
    color: #646a73;
    font-size: 28rpx;
}

.form {
    padding: 48rpx 40rpx;
}

.input {
    box-sizing: border-box;
    height: 96rpx;
    padding: 0 24rpx;
    margin-bottom: 24rpx;
    border: 2rpx solid #e5e8eb;
    border-radius: 16rpx;
    font-size: 30rpx;
}

.submit {
    margin-top: 16rpx;
    height: 96rpx;
    line-height: 96rpx;
}

.error {
    display: block;
    margin-top: 24rpx;
    color: #d93026;
    font-size: 26rpx;
    text-align: center;
}
